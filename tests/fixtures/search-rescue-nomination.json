    {
      "id": "unicode-lookalikes-not-folded",
      "query": "policy archive",
      "content": "/* рolicy аrchive */",
      "expected": false
    },
    {
      "id": "diacritic-not-transliterated",
      "query": "policy archive",
      "content": "/* policies arçhive */",
      "expected": false
