{
  "version": 1,
  "purpose": "Frozen general rescue-only nomination witnesses and negative controls; synthetic unit contract, not a retrieval accuracy benchmark.",
  "contract": {
    "scope": "Replace rescue fuzzy OR nomination deliberately; keep strict fuzzy retrieval and exact rescue admission unchanged.",
    "nomination": "Conservative literal fragments across content, basename, componentName, symbolName, functionName, className and exports; filters before the dynamic cap; stable original chunk ordinal.",
    "window": "min(750,max(256,limit*80)); overflow is disclosed through candidateBudgetExhausted. Witness completeness applies inside the nominated window, not beyond it.",
    "ranking": "Existing exact evidence rank and score remain; equal exact evidence uses original ordinal instead of fuzzy nomination score. This is an intentional nomination and tie-order change, not parity.",
    "normalization": "Existing ASCII lexical splitting and case folding only; no new Unicode transliteration, synonyms or language-specific rules.",
    "fallback": "No fuzzy OR rescan in rescue, including overflow/refill; original strict fuzzy search remains the typo and extended-syntax route."
  },
  "lexicalCases": [
    {
      "id": "plural-policy-to-singular",
      "query": "policy archive",
      "content": "/* policies archiving */",
      "expected": true,
      "expectedScore": 0.5
    },
    {
      "id": "singular-to-plural-query",
      "query": "policies archives",
      "content": "/* policy archive */",
      "expected": true,
      "expectedScore": 0.5
